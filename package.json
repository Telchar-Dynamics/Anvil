{
	"name": "@telchar/anvil",
	"version": "0.1.0",
	"description": "Tactical HUD component library for Svelte - forged at Telchar Dynamics",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles": "./dist/styles/anvil.css"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^4.0.0 || ^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@types/node": "^20.0.0",
		"eslint": "^9.0.0",
		"prettier": "^3.0.0",
		"prettier-plugin-svelte": "^3.0.0",
		"publint": "^0.2.0",
		"svelte": "^4.2.0",
		"svelte-check": "^3.6.0",
		"tslib": "^2.6.0",
		"typescript": "^5.0.0",
		"vite": "^5.0.0"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"keywords": [
		"svelte",
		"components",
		"ui",
		"tactical",
		"hud",
		"c2",
		"military",
		"design-system"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Telchar-Dynamics/Anvil.git"
	},
	"author": "Telchar Dynamics"
}
